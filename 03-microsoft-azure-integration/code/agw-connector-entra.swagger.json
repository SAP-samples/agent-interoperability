{
  "swagger": "2.0",
  "info": {
    "title": "agw-connector-entra",
    "description": "SAP Agent Gateway A2A connector template — Entra two-step exchange (Approach A). Carries the x-ms-agentic-protocol marker so the connector is attachable as a native A2A agent in Copilot Studio.",
    "version": "1.0"
  },
  "host": "<region>.access.sapdas.cloud.sap",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [],
  "produces": [],
  "paths": {
    "/v1/a2a/<ORD_ID>/<CAD_ID>/jsonrpc": {
      "post": {
        "responses": {
          "default": {
            "description": "default",
            "schema": {}
          }
        },
        "x-ms-agentic-protocol": "a2a-1.0",
        "x-ms-a2a-card-endpoint": "undefined",
        "x-ms-a2a-card-json": "null\n",
        "operationId": "InvokeA2A",
        "tags": [
          "A2A"
        ],
        "summary": "InvokeA2A",
        "description": "Send an A2A JSON-RPC message/send request to the agent behind the SAP Agent Gateway. Copilot Studio's A2A layer builds the JSON-RPC envelope; only the headers below are declared.",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "application/json"
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "en"
          }
        ]
      }
    }
  },
  "definitions": {},
  "parameters": {},
  "responses": {},
  "security": [
    {
      "oauth2-auth": [
        "api://<ENTRA_API_APP_ID>/access_as_user"
      ]
    }
  ],
  "tags": [],
  "securityDefinitions": {
    "oauth2-auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "tokenUrl": "https://login.windows.net/common/oauth2/authorize",
      "scopes": {
        "api://<ENTRA_API_APP_ID>/access_as_user": "api://<ENTRA_API_APP_ID>/access_as_user"
      },
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize"
    }
  }
}
