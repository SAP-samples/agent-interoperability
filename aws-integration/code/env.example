# Configuration for the MCP runtime build/deploy and smoke test.
#
# Copy this file to `.envrc` and fill in your own values. direnv loads `.envrc`
# automatically on `cd`; the build/deploy scripts also source it directly, so
# direnv is optional.
#
# No secrets live here — these are AWS resource identifiers. The KMS key signs
# server-side (the private key never leaves KMS) and Cognito values are public.
# `.envrc` is git-ignored so your filled-in copy is never committed.

# --- AWS target ---
export AWS_REGION=<region>                      # e.g. eu-central-1
export AWS_ACCOUNT=<your-account-id>            # 12-digit AWS account id

# --- Cognito (end-user auth: runtime authorizer + run_once smoke test) ---
export COGNITO_USER_POOL_ID=<cognito-user-pool-id>
export COGNITO_APP_CLIENT_ID=<cognito-app-client-id>
export COGNITO_DOMAIN=https://<your-domain>.auth.<region>.amazoncognito.com

# --- SAP IAS (on-behalf-of exchange via AgentCore Identity) ---
export IAS_CREDENTIAL_PROVIDER=<ias-credential-provider-name>
export IAS_RESOURCE_URN=urn:sap:identity:application:provider:name:agent-gateway
export IAS_KMS_KEY_ID=<kms-key-id>

# SAP IAS tenant (Task 3) — needed to CREATE the AgentCore Identity credential provider (Task 4)
export IAS_TENANT_URL=https://<tenant>.accounts.ondemand.com                 # discovery URL base
export IAS_DISCOVERY_URL=https://<tenant>.accounts.ondemand.com/.well-known/openid-configuration
export IAS_AUD_CLAIM=https://<tenant>.accounts.ondemand.com                  # aud in the private_key_jwt payload; its domain may differ from the discovery host — see ROADMAP Troubleshooting
export IAS_CLIENT_ID=<ias-app-client-id>

# --- Live config table (the runtime reads this row each request) ---
export AGENT_CONFIG_TABLE=<dynamodb-config-table>
export AGENT_CONFIG_KEY=current
export CONFIG_CACHE_TTL_SECONDS=30

# --- Deploy targets ---
export RUNTIME_NAME=<runtime-name>                      # e.g. cookbook_agentcore_sap_mcp
export EXEC_ROLE=<runtime-execution-role>               # e.g. cookbook-agentcore-sap-mcp-runtime
export CODE_BUCKET=cookbook-agentcore-code-${AWS_ACCOUNT}-${AWS_REGION}
export CODE_S3_KEY=<prefix>/deployment-mcp-llm.zip      # e.g. cookbook-agentcore-sap/deployment-mcp-llm.zip
export IAS_KMS_KEY_ARN=arn:aws:kms:${AWS_REGION}:${AWS_ACCOUNT}:key/${IAS_KMS_KEY_ID}

# --- Outputs: record these from each create command's response as you create resources ---
# Runtime (Task 6)
export RUNTIME_ID=<runtime-id>                          # e.g. cookbook_agentcore_sap_mcp-xxxxxxxxxx
export RUNTIME_ARN=arn:aws:bedrock-agentcore:${AWS_REGION}:${AWS_ACCOUNT}:runtime/${RUNTIME_ID}
# MCP endpoint (used by tests/integration/run_once.py and the Amazon Quick connector).
# The runtime's direct /invocations URL: the runtime ARN is URL-encoded (: -> %3A, / -> %2F)
# into the path, and qualifier=DEFAULT follows the latest runtime version on each redeploy.
_ENC_ARN=${RUNTIME_ARN//:/%3A}; _ENC_ARN=${_ENC_ARN//\//%2F}
export MCP_ENDPOINT_URL="https://bedrock-agentcore.${AWS_REGION}.amazonaws.com/runtimes/${_ENC_ARN}/invocations?qualifier=DEFAULT"
